# Dispatched — environment variables.
# Copy to .env.local (gitignored) and fill in for local dev.
# Render injects these from the dashboard in production.

NEXT_PUBLIC_SITE_URL=
# Optional. Leave unset until a confirmed replacement phone exists.
# NEXT_PUBLIC_SUPPORT_PHONE=
SENTRY_DSN=
DATABASE_URL=

# Mainline partner widget host — the /apply page embeds Mainline's BTC funding
# quiz from https://<host>/w/dispatched-finance. Public — ships to the browser.
# Defaults to mainline.tryoption.ai if unset; override only to point at a
# staging Mainline instance.
NEXT_PUBLIC_MAINLINE_WIDGET_HOST=mainline.tryoption.ai

# Google Ads conversion measurement. Both must be set or the tag is not
# rendered and no conversion event is sent. A GA4 measurement id is not a
# conversion label, and a conversion action id is not an AW- tag id.
# Leave both blank until the operator pastes the tag id (AW-digits) and the
# conversion label from the Google Ads snippet. These values are public;
# they are not secrets. Do not put an access token here.
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Coverdash producer-partner embed (used on /insurance and below).
# Coverdash is the named licensed insurance producer for the trucking
# insurance funnel. They hold the carrier appointments and bind policies;
# Dispatched routes intent to them.
#
# Three render modes; the component picks the first one whose vars are set:
#   1. Widget — set NEXT_PUBLIC_COVERDASH_WIDGET_SCRIPT_SRC
#      Loads the official Coverdash bundle and mounts <coverdash-embed>.
#      This is the preferred path once Coverdash BD delivers the script src
#      tagged to our partner license.
#   2. Iframe — set NEXT_PUBLIC_COVERDASH_QUOTES_BASE_URL +
#      NEXT_PUBLIC_COVERDASH_LICENSE_ID. Mirrors the Coverdash × Zeni
#      page pattern: an <iframe> to {base}?license={id}&prefilled_*.
#   3. Deeplink fallback — neither set. Renders product CTAs that route to
#      /apply so the conversion surface is never dead.
#
# License ID + quote-engine origin are public identifiers (visible in the
# Zeni partner page URL). No secret material lives in NEXT_PUBLIC_ vars.
NEXT_PUBLIC_COVERDASH_LICENSE_ID=
NEXT_PUBLIC_COVERDASH_QUOTES_BASE_URL=
NEXT_PUBLIC_COVERDASH_WIDGET_SCRIPT_SRC=

# Search engine site verification tokens. Used by app/layout.tsx to emit
# <meta name="google-site-verification"> and <meta name="msvalidate.01">.
# - Get the Google token from Search Console: Settings → Ownership
#   verification → "HTML tag" method → copy the content="..." value.
# - Get the Bing token from Bing Webmaster Tools: Settings → Ownership
#   → "Meta tag" method → copy the content="..." value.
# Both are public — they're emitted in <head>. Leaving them blank is safe;
# the tags simply won't render until they're set in Render dashboard env.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Bearer secret for the IndexNow cron route at /api/cron/indexnow.
# Set to a random 32+ char string. Generate: openssl rand -hex 32
# In the Render dashboard, set the SAME value on both the web service
# AND the indexnow-ping cron job — the route returns 401 if the bearer
# in the cron's curl call doesn't match the web service's env var.
# Locally: only needed if you want to hit /api/cron/indexnow during dev.
CRON_SECRET=

# Optional: override the IndexNow key the route submits with. The default
# is the value baked into the static file at
# public/f7d09b96f43c7976a9a6e1f50552181f.txt. Only change this if you've
# rotated the key AND replaced/renamed the static file in /public to
# match — IndexNow verifies the key by fetching keyLocation.
# Generate a new key with: openssl rand -hex 16
INDEXNOW_KEY=

# Optional: override the host IndexNow claims ownership of. Defaults to
# dispatched.finance (or the hostname of NEXT_PUBLIC_SITE_URL if set).
INDEXNOW_HOST=

# PostHog product analytics. Reports into the shared Mainline PostHog
# project (US region, project 428185) — the same project that powers
# mainline-app's tenant blogs. Both values are publishable / client-side
# safe and are emitted to the browser; they're committed here and in
# render.yaml so the app works without provisioning anything in Render.
# Override only if the PostHog project moves.
NEXT_PUBLIC_POSTHOG_KEY=phc_o5qp8URU8jp3hTPVGWkuABjdGKjpiHstuxqSvh39w5Uc
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Bearer secret for the Mainline crawler-analytics ingest. The Next.js proxy
# (proxy.ts) POSTs every non-asset request to
# https://mainline.tryoption.ai/api/ingest/hit with
# `Authorization: Bearer $MAINLINE_INGEST_SECRET`. Mainline persists hits
# whose UA matches a known crawler; everything else is silently dropped.
# The operator shares the value out-of-band — do NOT commit it. If unset at
# runtime the helper short-circuits to a no-op, so deploys without the
# secret don't crash, they just stop reporting. The hostname must also be
# registered on the Mainline Integration page or the endpoint returns 404
# on every request.
MAINLINE_INGEST_SECRET=

# --- Outbound email (FMCSA outreach kits) --------------------------------
# See docs/outreach/README.md. The first three are needed on the web
# service (unsubscribe + webhook routes); the sender script needs all of
# them except the webhook secret.

# AgentMail API key. Secret. The web routes use it to add unsubscribes,
# bounces and complaints to the organization block list.
AGENTMAIL_API_KEY=
# Signs unsubscribe links. Must be the same value wherever emails are
# rendered and on the web service. Generate: openssl rand -hex 32
OUTREACH_UNSUBSCRIBE_SECRET=
# Signing secret (whsec_...) of the AgentMail webhook that points at
# /api/outreach/webhook.
AGENTMAIL_WEBHOOK_SECRET=

# Sender script only (npm run outreach:send).
# Comma-separated AgentMail inbox ids on the outreach domains. Never use
# an inbox on dispatched.finance itself.
OUTREACH_INBOXES=
# Real person or team name that signs the emails.
OUTREACH_SENDER_NAME=
# Total sends per run and per inbox. Raise on the ramp schedule in the
# docs, not all at once.
OUTREACH_DAILY_CAP=200
OUTREACH_PER_INBOX_CAP=30
# Sends are spread across this many hours.
OUTREACH_WINDOW_HOURS=8
# The run stops when the rolling 24h rate passes either limit.
OUTREACH_MAX_BOUNCE_RATE=0.02
OUTREACH_MAX_COMPLAINT_RATE=0.001
# plain (default) or branded.
OUTREACH_LAYOUT=plain
# Optional. Defaults to https://dispatched.finance.
# OUTREACH_SITE_URL=
